# ─────────────────────────────────────────────────────────────────────────
# Vomia web + worker environment
# Copy to .env.local (Next.js) and .env (worker), fill in real values.
# NOTHING in this file is a user's wallet key. See SECURITY.md.
# ─────────────────────────────────────────────────────────────────────────

# ── Network ──────────────────────────────────────────────────────────────
# "mainnet" or "testnet". START ON TESTNET.
NEXT_PUBLIC_NETWORK=testnet
CELO_RPC_URL=https://forno.celo.org
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# ── Web3Auth (user wallets — MPC, client-side only) ──────────────────────
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=

# ── Database (metadata only: users, risk profiles, trade logs) ───────────
MONGODB_URI=mongodb+srv://...

# ── The agent operator key ───────────────────────────────────────────────
# Generate a FRESH throwaway key for this. It is the agent service's own
# low-privilege wallet: it pays gas and calls AgentVault.executeSwap within
# each user's on-chain caps — nothing else. It must NOT be your personal
# wallet, the deployer key, or anything holding meaningful funds.
# Before real user funds: move this into KMS (see lib/vault/operatorSigner.ts).
AGENT_OPERATOR_PRIVATE_KEY=

# ── Contracts (from `npm run deploy:*` in /contracts) ────────────────────
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=

# ── LLM ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── x402 (paid endpoints — Celo's hosted facilitator) ───────────────────
# Get the key at https://api.x402.celo.org: connect a wallet, sign a
# message (no gas), receive the key + 500 free credits. Same key works on
# Celo Sepolia (free credits) and mainnet. ~\$0.001/settlement — price
# endpoints above that.
CELO_X402_API_KEY=
CELO_X402_FACILITATOR_URL=https://api.x402.celo.org
# Wallet that RECEIVES x402 payments for /api/x402/* — your revenue wallet.
# Payments move buyer -> this address directly; the facilitator holds nothing.
X402_PAYOUT_WALLET_ADDRESS=

# ── Worker tuning ────────────────────────────────────────────────────────
HEARTBEAT_SECONDS=60
SCAN_AMOUNT_HUMAN=10
# Opt-in: skip the per-vault strategies entirely and instead DCA the OPERATOR
# wallet's own USDm into CELO (10 USDm/minute, sold back after 4-5 buys).
# Custodial for the operator's own working balance only — no user funds — and
# the only trades that score ERC-8021 tagged volume, since a vault contract is
# never tx_from. Needs USDm in the operator wallet to trade, plus CELO for gas.
OPERATOR_DIRECT_TRADING=false

# ── DEX / aggregator integrations ────────────────────────────────────────
# Uniswap QuoterV2 on Celo — pull from docs.celo.org/tooling/contracts/uniswap-contracts
# (deliberately not hardcoded; see lib/dex/uniswap.ts header for why)
UNISWAP_QUOTER_V2_ADDRESS=
# Free — request at docs.squidrouter.com
SQUID_INTEGRATOR_ID=
LIFI_INTEGRATOR_NAME=vomia-agent

# ── Attribution ──────────────────────────────────────────────────────────
NEXT_PUBLIC_ATTRIBUTION_APP_ID=vomia
