# Deployer key — throwaway wallet with a little CELO for gas. NOT the
# operator key, NOT a personal wallet.
DEPLOYER_PRIVATE_KEY=

# The agent service's operator ADDRESS (matches AGENT_OPERATOR_PRIVATE_KEY
# in web/.env — but only the address goes here).
AGENT_OPERATOR_ADDRESS=

CELO_RPC_URL=https://forno.celo.org
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
